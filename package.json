{
  "name": "projeto-patty",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:method": "node --experimental-strip-types --test lib/method/*.test.ts",
    "test:protocol": "node --experimental-strip-types --test lib/protocol/*.test.ts",
    "test:content": "node --experimental-strip-types --test lib/content/*.test.ts",
    "test:follow-up": "node --experimental-strip-types --test lib/follow-up/*.test.ts",
    "test:ai": "node --experimental-strip-types --test lib/ai/*.test.ts",
    "test:e2e-helpers": "node --test e2e/helpers/*.test.mjs && node --check e2e/client-operational-navigation.spec.mjs",
    "test:validation": "node --experimental-strip-types --test lib/validation/*.test.ts",
    "test:assignments": "node --experimental-strip-types --test lib/assignments/*.test.ts",
    "test:onboarding": "node --experimental-strip-types --test lib/onboarding/*.test.ts",
    "test:anamnesis-draft": "node --experimental-strip-types --test lib/anamnesis/*.test.ts",
    "test:security-boundaries": "node --test security/*.test.mjs",
    "test:drive-triage": "node --test lib/content/drive-triage.test.mjs",
    "eval:ai:openai": "node --experimental-strip-types scripts/eval-openai-anamnesis-review.ts",
    "test:media-migration": "node --test lib/content/educational-media-migration.test.mjs",
    "test:evaluations": "node --experimental-strip-types --test lib/evaluations/*.test.ts",
    "test:training": "node --experimental-strip-types --test lib/training/*.test.ts",
    "test:clients": "node --experimental-strip-types --test lib/clients/*.test.ts lib/checkins/*.test.ts lib/weekly-feedback/*.test.ts lib/files/*.test.ts",
    "test:operations": "node --experimental-strip-types --test lib/operations/*.test.ts",
    "test:configuration": "node --experimental-strip-types --test lib/configuration/*.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@vercel/blob": "2.6.1"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "supabase": "2.117.0",
    "typescript": "7.0.2"
  }
}
